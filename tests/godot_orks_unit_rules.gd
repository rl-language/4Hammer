extends SceneTree

func _initialize():
	call_deferred("check_rules")

func identifier(value):
	var result = RLCUnitID.make()
	result.get_id().set_value(value)
	return result

func panel_for(rules, library, action):
	var wrapped = RLCAnyGameAction.make()
	library.assign(wrapped, action)
	rules.valid_actions = [wrapped]
	var panel = VBoxContainer.new()
	panel.set_script(load("res://MultipleChoises.gd"))
	var buttons = VBoxContainer.new()
	buttons.name = "ChoiseList"
	panel.add_child(buttons)
	root.add_child(panel)
	assert(panel.get_node("ChoiseList").get_child_count() == 1)
	return panel

func check_rules():
	var rules = root.get_node("GlobalRules")
	var library = rules.library
	assert(library.get_state_schema_version() == 35)
	assert(library.get_action_schema_version() == 23)
	var board = RLCBoard.make()
	var boss = library.make_orks_beastboss()
	library.get(boss.get_models(), 0).get_position().get_x().set_value(5)
	library.get(boss.get_models(), 0).get_position().get_y().set_value(5)
	library.append(board.get_units(), boss)
	var hogs = library.make_orks_squighog_boyz(1, 3)
	for index in range(4):
		var model = library.get(hogs.get_models(), index)
		model.get_position().get_x().set_value(5 + (index % 2) * 4)
		model.get_position().get_y().set_value(14 + (index / 2) * 4)
	library.append(board.get_units(), hogs)
	var enemy = library.make_octavius()
	enemy.set_owned_by_player1(true)
	var model = library.get(enemy.get_models(), 0)
	model.get_position().get_x().set_value(15)
	model.get_position().get_y().set_value(14)
	library.append(board.get_units(), enemy)
	library.identify_units(board)
	var phase = RLCBattlePhase.make()
	phase.set_value(2) # movement
	library.begin_phase(board, phase)
	library.register_orks_unit_rules(board)
	assert(library.size(board.get_source_instances()) == 3)
	var event = RLCSourceEvent.make()
	event.get_kind().set_value(1) # move_start
	library.assign(event.get_unit(), library.get(board.get_units(), 0).get_identity())
	var sequence = library.resolve_movement_sources(board, event)
	var source_action = RLCGameChooseMovementSource.make()
	assert(library.can_choose_movement_source(sequence, board, source_action.get_event()))
	library.assign(rules.state.get_board(), board)
	var panel = panel_for(rules, library, source_action)
	assert(rules.strip_symbols("Keep Huntin") in panel.get_node("ChoiseList").get_child(0).text)
	panel.free()
	library.choose_movement_source(sequence, board, source_action.get_event())
	var hunt = RLCGameChooseKeepHuntinTarget.make()
	assert(hunt.members_count() == 1 and hunt.get_member(0) is RLCUnitID)
	assert(library.can_choose_keep_huntin_target(sequence, board, hunt.get_hunt_target()))
	library.assign(rules.state.get_board(), board)
	panel = panel_for(rules, library, hunt)
	assert(rules.strip_symbols("Keep Huntin") in panel.get_node("ChoiseList").get_child(0).text)
	assert(rules.get_current_select_unit_action() is RLCGameChooseKeepHuntinTarget)
	panel.free()
	library.choose_keep_huntin_target(sequence, board, hunt.get_hunt_target())
	assert(library.is_done(sequence) and library.unit_is_riled_up(library.get(board.get_units(), 0)))
	event.get_kind().set_value(2) # move_end
	event.get_movement().set_value(1) # normal
	library.assign(event.get_unit(), library.get(board.get_units(), 1).get_identity())
	sequence = library.resolve_movement_sources(board, event)
	library.choose_movement_source(sequence, board, source_action.get_event())
	var bomb = RLCGameChooseBombSquigTarget.make()
	library.assign(bomb.get_bomb_target(), identifier(2))
	assert(bomb.members_count() == 1 and bomb.get_member(0) is RLCUnitID)
	assert(library.can_choose_bomb_squig_target(sequence, board, identifier(2)))
	library.assign(rules.state.get_board(), board)
	panel = panel_for(rules, library, bomb)
	assert(rules.strip_symbols("Bomb Squig") in panel.get_node("ChoiseList").get_child(0).text)
	assert(rules.get_current_select_unit_action() is RLCGameChooseBombSquigTarget)
	panel.free()
	library.choose_bomb_squig_target(sequence, board, identifier(2))
	var die = RLCBIntT1T7T.make()
	die.set_value(2)
	library.roll(sequence, board, die)
	assert(library.is_done(sequence))
	assert(library.size(board.get_source_uses()) == 2)
	var shock = RLCGameChooseMobbedTarget.make()
	library.assign(shock.get_shock_target(), identifier(2))
	library.assign(rules.state.get_board(), board)
	panel = panel_for(rules, library, shock)
	assert(rules.strip_symbols("Mobbed") in panel.get_node("ChoiseList").get_child(0).text)
	assert(rules.get_current_select_unit_action() is RLCGameChooseMobbedTarget)
	panel.free()
	var snapshot = rules.as_indented_str(rules.state)
	var restored = library.play()
	assert(library.set_state(restored, RLCLib.godot_string_to_rlc_string(snapshot)))
	assert(library.size(restored.get_board().get_source_uses()) == 2)
	print("PASS: Godot schema exports, Orks targeted source choices, labels, unit-click discovery, token use and saves")
	library.free()
	call_deferred("quit", 0)
