extends SceneTree

func _initialize():
	call_deferred("check_unit_data")

func check_unit_data():
	var rules = root.get_node("GlobalRules")
	var library = rules.library
	assert(library.get_state_schema_version() == 35)
	assert(library.get_observation_schema_version() == 35)
	assert(library.get_action_schema_version() == 23)
	var boss = library.make_orks_beastboss()
	var bearer = library.get(boss.get_models(), 0)
	assert(library.thoughness(bearer.get_profile()) == 6)
	assert(library.invuln_save(bearer.get_profile()) == 5)
	assert(library.feel_no_pain(bearer.get_profile()) == 6)
	assert(bearer.get_has_waaagh() and bearer.get_has_da_boss())
	assert(boss.get_attachment_role().get_value() == 1)
	assert(library.size(bearer.get_weapons()) == 2)
	assert(str(library.label(library.equipped_named_weapon(bearer, 1))) == "Beast Snagga Klaw and Beastchoppa")
	assert(not library.orks_snagga_composition_valid(1, 9, 2))
	var mob = library.make_orks_beast_snagga_boyz(2, 18, 2)
	assert(library.size(mob.get_models()) == 20)
	var boy = library.get(mob.get_models(), 2)
	assert(library.wounds(boy.get_profile()) == 1 and library.invuln_save(boy.get_profile()) == 6)
	assert(library.feel_no_pain(boy.get_profile()) == 10)
	assert(library.size(boy.get_weapons()) == 4)
	assert(str(library.label(library.equipped_named_weapon(boy, 3))) == "Thump Gun")
	assert(str(library.label(library.equipped_named_profile(boy, 2))) == "Choppa - Hunter")
	var hogs = library.make_orks_squighog_boyz(2, 6)
	assert(library.size(hogs.get_models()) == 8)
	var nob = library.get(hogs.get_models(), 0)
	assert(library.wounds(nob.get_profile()) == 4 and library.thoughness(nob.get_profile()) == 6)
	assert(library.base_size(nob.get_profile()) == 90.0)
	assert(library.profile_base_width(nob.get_profile()) == 52.0)
	assert(not nob.get_geometry().get_unsupported_footprint())
	assert(library.profile_has_oval_base(nob.get_profile()))
	var mounted_boy = library.get(hogs.get_models(), 2)
	assert(library.profile_base_width(mounted_boy.get_profile()) == 42.0)
	assert(library.size(mounted_boy.get_weapons()) == 4)
	assert(str(library.label(library.equipped_named_profile(mounted_boy, 2))) == "Stikka (melee)")
	var board = RLCBoard.make()
	library.append(board.get_reserve_units(), mob)
	library.append(board.get_reserve_units(), boss)
	library.identify_units(board)
	var source = RLCUnitID.make()
	source.get_id().set_value(1)
	var target = RLCUnitID.make()
	assert(library.attachment_valid(board, source, target, false))
	library.attach_reserved_unit(board, source, target, false)
	var combined = library.get(board.get_reserve_units(), 0)
	assert(library.size(combined.get_models()) == 21)
	assert(combined.get_starting_strenght().get_value() == 21)
	assert(library.valid_state_foundations(board))
	library.assign(rules.state.get_board(), board)
	var snapshot = rules.as_indented_str(rules.state)
	var restored = library.play()
	assert(library.set_state(restored, RLCLib.godot_string_to_rlc_string(snapshot)))
	assert(library.size(library.get(restored.get_board().get_reserve_units(), 0).get_models()) == 21)
	print("PASS: Godot schema exports, current Orks profiles/loadouts, Hunter labels, attachment metadata, oval circle proxies and saved data")
	library.free()
	call_deferred("quit", 0)
