extends SceneTree

func _initialize():
	call_deferred("check_modifier_ignoring")

func check_modifier_ignoring():
	var rules = root.get_node("GlobalRules")
	var library = rules.library
	assert(library.get_state_schema_version() == 40)
	assert(library.get_observation_schema_version() == 40)
	assert(library.get_action_schema_version() == 26)
	var board = RLCBoard.make()
	var origin = RLCModifierOrigin.make()
	origin.set_value(4) # damaged
	var operation = RLCModifierOperation.make()
	operation.set_value(2) # add
	var choice = library.attack_modifier_choice(library.rule_modifier(operation, -1), origin)
	# Borrow the actual alias type; retain its parent for the wrapper lifetime.
	var choice_frame = RLCChooseAttackModifiers.make()
	var choices = choice_frame.get_choices()
	library.append(choices, choice)
	var kind = RLCModifierSelectionKind.make()
	kind.set_value(2) # hit_roll
	board.set_current_decision_maker(true)
	var sequence = library.choose_attack_modifiers(board, choices, false, kind, true)
	assert(not board.get_current_decision_maker())
	assert(library.can_apply_attack_modifier(sequence, board, true))
	assert(library.can_apply_attack_modifier(sequence, board, false))
	library.assign(rules.state.get_board(), board)
	var keep = RLCGameApplyAttackModifier.make()
	keep.set_apply_it(true)
	var drop = RLCGameApplyAttackModifier.make()
	drop.set_apply_it(false)
	assert(keep.members_count() == 1 and keep.get_member(0) is bool)
	var wrapped_keep = RLCAnyGameAction.make()
	var wrapped_drop = RLCAnyGameAction.make()
	library.assign(wrapped_keep, keep)
	library.assign(wrapped_drop, drop)
	rules.valid_actions = [wrapped_keep, wrapped_drop]
	var panel = VBoxContainer.new()
	panel.set_script(load("res://MultipleChoises.gd"))
	var buttons = VBoxContainer.new()
	buttons.name = "ChoiseList"
	panel.add_child(buttons)
	root.add_child(panel)
	assert(buttons.get_child_count() == 2)
	var detail = library.convert_string(library.modifier_choice_label(board))
	assert(buttons.get_child(0).text == rules.strip_symbols("Apply " + detail))
	assert(buttons.get_child(1).text == rules.strip_symbols("Ignore " + detail))
	assert(buttons.get_child(0).text.contains("damaged"))
	panel.free()
	library.apply_attack_modifier(sequence, board, false)
	assert(library.is_done(sequence))
	assert(library.size(sequence.get_result()) == 0)
	assert(board.get_current_decision_maker())
	var scope = RLCIncomingAttackScope.make()
	var permission = library.attack_modifier_permission(true, true, scope)
	var unit = library.make_infernus_squad()
	var model = library.get(unit.get_models(), 0)
	library.append(model.get_attack_modifier_permissions(), permission)
	assert(library.valid_attack_modifier_permissions(model.get_attack_modifier_permissions()))
	assert(library.attack_permission_available(board, model, false, true))
	assert(library.attack_permission_available(board, model, true, false))
	print("PASS: Godot schema exports, Apply/Ignore buttons, provenance, owner restoration and scoped permissions")
	library.free()
	call_deferred("quit", 0)
