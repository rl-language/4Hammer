extends SceneTree

func _initialize():
	call_deferred("check_hooks")

func check_hooks():
	var library = root.get_node("GlobalRules").library
	assert(library.get_state_schema_version() == 47)
	assert(library.get_action_schema_version() == 27)
	var board = RLCBoard.make()
	library.append(board.get_units(), library.make_orks_beastboss())
	library.identify_units(board)
	var unit = library.get(board.get_units(), 0)
	var model = library.get(unit.get_models(), 0)
	var attack = RLCAttackSequenceInfo.make()
	library.append_unit_hit_modifiers(unit, attack.get_unit_ability_hit_modifiers())
	assert(library.size(attack.get_unit_ability_hit_modifiers()) == 1)
	assert(library.total_hit_modifier(attack) == 1)
	var term = library.get(attack.get_unit_ability_hit_modifiers(), 0)
	term.get_amount().set_value(3)
	assert(library.total_hit_modifier(attack) == 3)
	var charge = RLCChargeRollEffects.make()
	library.append_charge_roll_effects(board, unit, charge)
	assert(not charge.get_reroll())
	assert(library.size(charge.get_modifiers()) == 0)
	var key_holder = RLCRuleEffectGrant.make()
	key_holder.get_source_effect().set_value(9)
	library.install_source_grant(model, library.riled_up_grant(), key_holder.get_source_effect())
	assert(library.is_riled_up(model))
	library.remove_source_grant(model, key_holder.get_source_effect())
	assert(not library.is_riled_up(model))
	var event = RLCPendingDestruction.make()
	event.set_found(true)
	var death = library.on_unit_destroyed(board, model, event)
	assert(library.is_done(death))
	assert(not death.get_effects().get_suppress_demise())
	assert(library.size(death.get_effects().get_damage_jobs()) == 0)
	assert(library.has_method("on_move_finished"))
	assert(library.has_method("on_command_phase_start"))
	assert(library.has_method("on_command_phase_end"))
	print("PASS: Godot schema exports concrete ability-hook calculations, status lifecycle and event results")
	library.free()
	quit()
