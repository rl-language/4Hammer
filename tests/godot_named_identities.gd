extends SceneTree

func _initialize():
	call_deferred("check_named_identities")

func check_named_identities():
	var library = root.get_node("GlobalRules").library
	assert(library.get_state_schema_version() == 25)
	assert(library.get_observation_schema_version() == 25)
	assert(library.get_action_schema_version() == 15)
	var board = RLCBoard.make()
	var attacker = library.make_hellblaster_squad()
	var defender = library.make_infernus_squad()
	defender.set_owned_by_player1(true)
	library.append(board.get_units(), attacker)
	library.append(board.get_units(), defender)
	library.identify_units(board)
	var bearer = library.get(library.get(board.get_units(), 0).get_models(), 0)
	var profile = RLCNamedWeaponProfile.make()
	profile.set_value(105)
	library.set_named_weapon_profile(bearer, 1, profile)
	profile.set_value(106)
	library.set_named_weapon_profile(bearer, 2, profile)
	var sheet = RLCOrksDatasheet.make()
	sheet.set_value(8)
	library.set_model_datasheet(bearer, sheet)
	assert(library.model_matches_datasheet(bearer, sheet))
	assert(library.unit_matches_datasheet(library.get(board.get_units(), 0), sheet))
	assert(library.named_model_datasheet(bearer).get_value() == 8)
	var family = library.equipped_named_weapon(bearer, 1)
	assert(family.get_value() == 82)
	assert(library.label(family) == "Kustom Shoota")
	assert(library.equipped_named_profile(bearer, 2).get_value() == 106)
	var kind = RLCModifiedCharacteristic.make()
	kind.set_value(10)
	var operation = RLCModifierOperation.make()
	operation.set_value(2)
	library.append(bearer.get_characteristic_modifiers(), library.named_weapon_modifier(kind, operation, 2, family))
	var source = RLCUnitID.make()
	var target = RLCUnitID.make()
	target.get_id().set_value(1)
	var declaration = library.make_declared_weapon(board, source, 0, 2)
	var neutral = RLCAttackSequenceInfo.make()
	var info = library.declared_attack_info(board, source, target, declaration, neutral)
	assert(library.attack_strength(info) == 10)
	# A physical grant includes the alternate profile but not a borrowed slot.
	library.append(bearer.get_characteristic_modifiers(), library.physical_weapon_modifier(kind, operation, 3, 1))
	var physical = library.declared_attack_info(board, source, target, declaration, neutral)
	assert(library.attack_strength(physical) == 13)
	declaration.set_borrowed_weapon(true)
	var borrowed = library.declared_attack_info(board, source, target, declaration, neutral)
	assert(library.attack_strength(borrowed) == 10)
	assert(library.valid_model_numeric_history(bearer))
	print("PASS: Godot schema exports, catalog labels, named profiles, physical grants and borrowed identity")
	library.free()
	call_deferred("quit", 0)
