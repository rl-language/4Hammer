extends SceneTree

func _initialize():
	call_deferred("check_weapons_sources")

func check_weapons_sources():
	var rules = root.get_node("GlobalRules")
	var library = rules.library
	assert(library.get_state_schema_version() == 26)
	assert(library.get_observation_schema_version() == 26)
	assert(library.get_action_schema_version() == 16)
	var board = RLCBoard.make()
	var unit = library.make_infernus_squad()
	library.append(board.get_units(), unit)
	library.identify_units(board)
	var actual_unit = library.get(board.get_units(), 0)
	var bearer = library.get(actual_unit.get_models(), 0)
	library.clear(bearer.get_weapons())
	var weapon = RLCWeapon.make()
	for slot in range(13):
		library.append(bearer.get_weapons(), weapon)
	assert(library.size(bearer.get_weapons()) == 13)
	library.set_physical_weapon_group(bearer, 0, 1)
	library.set_physical_weapon_group(bearer, 1, 1)
	library.set_physical_weapon_group(bearer, 2, 2)
	library.permit_simultaneous_ranged_profiles(bearer, 1)
	assert(library.permits_simultaneous_profile(bearer, 0))
	assert(library.permits_simultaneous_profile(bearer, 1))
	assert(not library.permits_simultaneous_profile(bearer, 2))
	var expression = library.compound_stat(2, 3, 2)
	var roll = library.evaluate_random_stat(expression)
	var die = RLCBIntT1T7T.make()
	die.set_value(2)
	library.quantity(roll, die)
	die.set_value(3)
	library.quantity(roll, die)
	assert(library.is_done(roll))
	assert(roll.get_result().get_value() == 7)
	var kind = RLCModifiedCharacteristic.make()
	var operation = RLCModifierOperation.make()
	operation.set_value(2) # add
	var grant = library.characteristic_modifier(kind, operation, 2)
	var source = RLCSourceInstance.make()
	source.get_rule().set_value(1)
	source.get_source_unit().set_value(actual_unit.get_identity().get_value())
	source.get_source_model().set_value(bearer.get_identity().get_value())
	library.assign(source.get_name().get_value(), actual_unit.get_name().get_value())
	source.set_optional(true)
	var window = RLCTimingWindow.make()
	window.set_value(8) # movement_start
	library.assign(source.get_window(), window)
	library.assign(source.get_grant(), library.source_characteristic_grant(grant))
	library.register_source_instance(board, source)
	var sequence = library.resolve_timing_window(board, window)
	var choice = RLCGameChooseWindowSource.make()
	assert(choice.members_count() == 1)
	assert(not choice.get_member(0) is RLCUnitID)
	assert(library.convert_string(library.pretty_string(board, choice)) == library.convert_string(actual_unit.get_name().get_value()))
	assert(library.can_choose_window_source(sequence, board, choice.get_event()))
	# Exercise the production choice panel: source handles need explicit
	# buttons because autodetection does not treat them as unit/model clicks.
	library.assign(rules.state.get_board(), board)
	var wrapped = RLCAnyGameAction.make()
	library.assign(wrapped, choice)
	rules.valid_actions = [wrapped]
	var panel = VBoxContainer.new()
	panel.set_script(load("res://MultipleChoises.gd"))
	var buttons = VBoxContainer.new()
	buttons.name = "ChoiseList"
	panel.add_child(buttons)
	root.add_child(panel)
	assert(buttons.get_child_count() == 1)
	assert(buttons.get_child(0).text == rules.strip_symbols("Resolve " + library.convert_string(actual_unit.get_name().get_value())))
	panel.free()
	library.choose_window_source(sequence, board, choice.get_event())
	assert(library.is_done(sequence))
	assert(library.effective_movement(bearer, 6) == 8)
	assert(library.valid_source_foundations(board))
	var phase = RLCBattlePhase.make()
	phase.set_value(3) # shooting
	library.begin_phase(board, phase)
	assert(library.effective_movement(bearer, 6) == 6)
	assert(library.size(board.get_source_effects()) == 0)
	print("PASS: Godot schema exports,13 profiles, compound dice and source choices/expiry")
	library.free()
	call_deferred("quit", 0)
